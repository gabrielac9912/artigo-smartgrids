lues\": 6,\n        \"samples\": [\n          1.923,\n          1.963,\n          1.951\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Mejora (%)\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2.483382102429399,\n        \"min\": 41.39,\n        \"max\": 48.15,\n        \"num_unique_values\": 6,\n        \"samples\": [\n          43.69,\n          41.46,\n          43.92\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","source":["¿Qué quiere decir esto?\n","MAE Original: Es el error \"de fábrica\" de tus sensores. Si es alto, significa que el sensor tiene un desvío importante respecto a la estación de referencia.\n","\n","MAE Calibrado: Es el error residual después de aplicar nuestra metodología. Si es menor al original, la metodología está funcionando.\n","\n","Mejora (%): Esta es tu métrica de impacto. Te dice qué porcentaje de error lograste eliminar gracias a la calibración.\n","\n","Si la mejora es positiva y alta (>20-30%): ¡Felicidades! La metodología está logrando \"entender\" el error sistemático y el ruido de tus sensores y está acercándolos exitosamente a la referencia."],"metadata":{"id":"sS5GWBzo3NPr"}},{"cell_type":"code","source":["print(\"--- Columnas de df ---\")\n","print(df.columns.tolist())\n","print(\"\\n--- Columnas de df_calibrado ---\")\n","print(df_calibrado.columns.tolist())\n","print(\"\\n--- ¿'Date' está en df_calibrado? ---\")\n","print('Date' in df_calibrado.columns)\n","print(\"\\n--- Primeras filas de df_calibrado ---\")\n","print(df_calibrado.head())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uQetRsbOS2xx","executionInfo":{"status":"ok","timestamp":1784581279452,"user_tz":180,"elapsed":10,"user":{"displayName":"Dana Gabriela Caceres Almeciga","userId":"10822779572467738577"}},"outputId":"132c044d-a1c7-4aa4-c5cf-